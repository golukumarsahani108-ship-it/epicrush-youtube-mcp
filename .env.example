# Google OAuth Web Client credentials (never commit real values)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Add the deployed callback URL in Google Cloud as an Authorized redirect URI:
# https://YOUR-RENDER-SERVICE.onrender.com/google/callback

# Paste the refresh_token shown once after visiting /google/auth
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token

# Generate a long random secret (at least 32 characters).
# Claude custom connector should send: Authorization: Bearer YOUR_MCP_ACCESS_TOKEN
MCP_ACCESS_TOKEN=replace-with-a-long-random-secret

PORT=10000
