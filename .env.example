# Public Render service URL (no trailing slash)
PUBLIC_BASE_URL=https://epicrush-youtube-mcp.onrender.com

# Generate a random secret of at least 32 characters. Keep private.
MCP_OAUTH_SIGNING_SECRET=PASTE_A_NEW_RANDOM_SECRET_HERE

# Create your own private password for approving Claude's connection.
MCP_OAUTH_ADMIN_PASSWORD=CREATE_A_STRONG_PRIVATE_PASSWORD

# Existing Google OAuth credentials for YouTube (never put real values in GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
